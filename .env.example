# Скопіюй у .env і заповни. Файл .env у .gitignore — він нікуди не їде.
#   cp .env.example .env && $EDITOR .env

# Telegram: створи бота через @BotFather, він дасть токен.
# chat_id: напиши боту будь-що, тоді відкрий
#   https://api.telegram.org/bot<ТОКЕН>/getUpdates
# і візьми message.chat.id
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Спільний стан між VPS і локальними запусками: щоб та сама квартира
# не прилетіла двічі. Без нього все працює на локальному SQLite.
MONGODB_URI=

# Потрібен для розбору оголошень вільної форми (Telegram-групи, Facebook).
# Для OLX і DIM.RIA не використовується.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
