# Скопіюй у .env і заповни. Файл .env у .gitignore — він нікуди не їде.
#   cp .env.example .env && $EDITOR .env

# Telegram: створи бота через @BotFather, він дасть токен.
# chat_id: напиши боту будь-що, тоді відкрий
#   https://api.telegram.org/bot<ТОКЕН>/getUpdates
# і візьми message.chat.id
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Nominatim (геокодування OpenStreetMap) просить контактну пошту в User-Agent
NOMINATIM_EMAIL=

# Спільний стан між VPS і локальними запусками: щоб та сама квартира
# не прилетіла двічі. Без нього все працює на локальному SQLite.
MONGODB_URI=

# Розбір описів оголошень: комуналка, комісія, депозит, тварини, генератор.
# Без ключа цей крок просто пропускається.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_MODEL_HEAVY=gemini-3.1-pro

# Безкоштовний ключ із developers.ria.com. Без нього DIM.RIA працює
# в урізаному режимі: 20 оголошень зі сторінки каталогу.
RIA_API_KEY=
